# Next.js Frontend Environment Variables
# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun

# ── TecDoc Catalog API (Natro PHP backend — şimdilik) ──
NEXT_PUBLIC_API_URL=https://api.parcabizden.com.tr

# Reviews API (her zaman Natro'da, Node.js dev server'da yok)
NEXT_PUBLIC_REVIEWS_URL=https://api.parcabizden.com.tr/reviews.php

# Chat widget'ı devre dışı bırakmak için: false
# NEXT_PUBLIC_CHAT_ENABLED=false
