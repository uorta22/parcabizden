# Database Configuration
DB_HOST=localhost
DB_NAME=parcabizden
DB_USER=parcabizden_user
DB_PASS=CHANGE_ME_SECURE_PASSWORD
DB_CHARSET=utf8mb4

# JWT Configuration
# Generate a secure random key with at least 32 characters
# Example: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_RANDOM_SECRET_KEY_MIN_32_CHARS

# CORS Configuration
# Set this to your production domain
ALLOWED_ORIGIN=https://parcabizden.com.tr

# Environment (development or production)
APP_ENV=production

# Error Logging
# Path to PHP error log file
ERROR_LOG_PATH=/var/log/php/parcabizden_errors.log
